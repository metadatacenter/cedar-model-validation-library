{
    "description": "Optional public navigation links for any controlled-term constraint. Version remains on the constraint.",
    "type": "object",
    "minProperties": 1,
    "properties": {
        "landingPage": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://[^/?#@\\s\\\\]+(?:[/?#][^\\s\\\\]*)?$"
        },
        "icon": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://[^/?#@\\s\\\\]+(?:[/?#][^\\s\\\\]*)?$"
        }
    },
    "additionalProperties": false
}
